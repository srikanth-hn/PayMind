# LLM provider — defaults to OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini        # any OpenRouter model id, e.g. anthropic/claude-sonnet-4.5

# To use another OpenAI-compatible provider, point the base URL and key at it instead.

# LangSmith observability
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGSMITH_PROJECT=paymind
LANGCHAIN_PROJECT=paymind
